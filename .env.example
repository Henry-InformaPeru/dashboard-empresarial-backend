# Copiar a un archivo .env local para desarrollo. No subir valores reales al repositorio.
# En producción (Sulotec, Oracle Cloud) estas variables viven en /opt/sulotec/dashboard.env del servidor.

PORT=3100

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# true solo si la base está fuera de la red interna y exige TLS
DB_SSL=false

# Mínimo 32 caracteres. Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# El esquema de validación solo admite 1h
JWT_EXPIRES_IN=1h

# Webs que pueden llamar a la API, separadas por coma (vacío = cualquiera, solo desarrollo).
# Producción: https://dashboards.sulotec.com
CORS_ORIGIN=
# true cuando la API va detrás de un proxy/túnel (Cloudflare)
TRUST_PROXY=false
